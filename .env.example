# Copy this file to .env and fill in real values. Never commit .env.

# Random secret (at least 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_SECRET_KEY=change-me-to-a-long-random-string

# Login of the single dashboard user.
JARVIS_ADMIN_USERNAME=admin

# Argon2 hash of the password (never the password itself). Generate it with:
#   docker compose -f docker-compose.dev.yml run --rm backend uv run python -m app.hash_password
# Keep the single quotes: the hash contains "$" characters.
JARVIS_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$replace$me'

# SQLite database location (inside the container).
JARVIS_DATABASE_URL=sqlite:////data/jarvis.db

# true when served over HTTPS (deployment), false for local http.
JARVIS_COOKIE_SECURE=false

# Session lifetime in hours.
JARVIS_SESSION_HOURS=8
