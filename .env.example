# Copy this file to .env and fill in real values. Never commit .env.

# Random secret (at least 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_SECRET_KEY=change-me-to-a-long-random-string

# Login of the single dashboard user.
JARVIS_ADMIN_USERNAME=admin

# Argon2 hash of the password (never the password itself). Generate it with:
#   docker compose -f docker-compose.dev.yml run --rm backend uv run python -m app.hash_password
# Keep the single quotes: the hash contains "$" characters.
JARVIS_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$replace$me'

# SQLite database location (inside the container).
JARVIS_DATABASE_URL=sqlite:////data/jarvis.db

# true when served over HTTPS (deployment), false for local http.
JARVIS_COOKIE_SECURE=false

# Session lifetime in hours.
JARVIS_SESSION_HOURS=8

# Local port of the deployment stack (docker-compose.yml), bound to 127.0.0.1 only.
JARVIS_HTTP_PORT=8080

# --- Veille cyber -----------------------------------------------------------
# Claude API key (optional). Without it, no daily summary nor product sheets.
# Only public vulnerability data is sent to the API. Never commit the key.
ANTHROPIC_API_KEY=
# Small model for summaries (see https://www.anthropic.com/pricing).
JARVIS_LLM_MODEL=claude-haiku-5-5
# NVD API key (optional, free): https://nvd.nist.gov/developers/request-an-api-key
JARVIS_NVD_API_KEY=

# --- OSINT ------------------------------------------------------------------
# Brave Search API key (optional): web mentions of your name and phone number.
# Free credit each month: https://api-dashboard.search.brave.com
JARVIS_BRAVE_API_KEY=

# --- Leboncoin ----------------------------------------------------------------
# Dedicated mailbox that receives the Leboncoin saved-search alerts (never your
# main mailbox). Read-only IMAP over TLS. Use an app password, not the account
# password. Leave the host empty to disable the module's collection.
JARVIS_LBC_IMAP_HOST=
JARVIS_LBC_IMAP_PORT=993
JARVIS_LBC_IMAP_USERNAME=
JARVIS_LBC_IMAP_PASSWORD=
JARVIS_LBC_IMAP_FOLDER=INBOX
